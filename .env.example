# ---------------------------------------------------------------------------
# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).
# Valores abaixo são apenas exemplos/placeholders — não são segredos reais.
# ---------------------------------------------------------------------------

# Obrigatória para o Assistente de Estilo (texto + tentativa de imagem Gemini).
GEMINI_API_KEY=sua-chave-do-google-ai-studio

# Modelos e timeouts (opcionais; valores padrão abaixo)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TIMEOUT_MS=30000
GEMINI_IMAGE_TIMEOUT_MS=90000

# Foto realista de fallback (Pollinations/FLUX) — não precisa de chave.
# Usada quando o Gemini não tem cota de imagem. Desative para usar só o SVG local.
IMAGE_POLLINATIONS_ENABLED=true
IMAGE_POLLINATIONS_BASE_URL=https://image.pollinations.ai
IMAGE_POLLINATIONS_TIMEOUT_MS=90000
IMAGE_POLLINATIONS_MODEL=flux

# Frontend separado (GitHub Pages). Lista separada por vírgulas se houver mais de uma.
# Em produção NUNCA use "*" — a API usa allowCredentials=true.
CORS_ALLOWED_ORIGINS=https://isaave.github.io

# URL pública usada pelo Swagger UI no botão "Execute".
OPENAPI_SERVER_URL=https://projeto2-apibarbie.onrender.com

# Porta: o Render define PORT automaticamente (10000). Localmente, 8080.
PORT=8080

# Confie em X-Forwarded-For apenas atrás de proxy reverso de confiança (Render).
APP_TRUST_PROXY_HEADERS=false

# Rate limiting por IP (janela em segundos).
RATE_LIMIT_READ_CAPACITY=10
RATE_LIMIT_WRITE_CAPACITY=5
RATE_LIMIT_WINDOW_SECONDS=60

# Diagnóstico local apenas — deixe false em produção.
H2_CONSOLE_ENABLED=false
JPA_SHOW_SQL=false

# Ajustes de JVM usados pelo Docker no Render (opcional localmente).
JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
