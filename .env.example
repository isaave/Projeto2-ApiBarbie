# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).

# Obrigatória para o Assistente de Estilo (texto + imagem)
GEMINI_API_KEY=sua-chave-do-google-ai-studio

# Opcionais (valores padrão)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TIMEOUT_MS=30000
GEMINI_IMAGE_TIMEOUT_MS=90000

# URL do frontend em produção (separada por vírgulas se houver mais de uma)
CORS_ALLOWED_ORIGINS=https://front-apibarbie.onrender.com

# Render define PORT automaticamente (10000). Localmente pode ignorar.
PORT=8080

# Diagnóstico local apenas — deixe false em produção
H2_CONSOLE_ENABLED=false
JPA_SHOW_SQL=false
